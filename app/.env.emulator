# Used by `npm run dev:emulator` / e2e tests — talks to local Firebase emulators only.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-cwc.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-cwc
VITE_FIREBASE_APP_ID=demo-app
VITE_USE_EMULATORS=true
VITE_API_URL=http://127.0.0.1:8787
VITE_CLOUDINARY_CLOUD_NAME=demo
