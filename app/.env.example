# Firebase web app config (Firebase console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudflare Worker (see /worker) — SMS via ProfJero Connect, web push, signed Cloudinary uploads
VITE_API_URL=https://cwc-api.<your-subdomain>.workers.dev

# Cloudinary (public values only — the API secret lives in the Worker)
VITE_CLOUDINARY_CLOUD_NAME=
# Optional: unsigned upload preset. Leave empty to use signed uploads via the Worker (recommended).
VITE_CLOUDINARY_UPLOAD_PRESET=

# Set to "true" to talk to local Firebase emulators (npm run emulators at repo root)
VITE_USE_EMULATORS=false
